{
  "name": "tipout-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && node scripts/check-convex-backend.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "postinstall": "prisma generate",
    "backfill:role-versions": "esbuild scripts/backfill-role-versions.ts --bundle --platform=node --packages=external --tsconfig=tsconfig.json --outfile=.tmp/backfill-role-versions.js --log-level=warning && node .tmp/backfill-role-versions.js",
    "migrate:convex": "esbuild scripts/migrate-to-convex.ts --bundle --platform=node --packages=external --tsconfig=tsconfig.json --outfile=.tmp/migrate-to-convex.js --log-level=warning && node .tmp/migrate-to-convex.js",
    "test:convex": "vitest run",
    "convex-to-postgres": "esbuild scripts/convex-to-postgres.ts --bundle --platform=node --packages=external --tsconfig=tsconfig.json --outfile=.tmp/convex-to-postgres.js --log-level=warning && node .tmp/convex-to-postgres.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.10",
    "@clerk/themes": "^2.2.26",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.5.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "chart.js": "^4.4.8",
    "convex": "^1.35.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.6.0",
    "next": "15.2.8",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.69",
    "eslint": "^9",
    "eslint-config-next": "15.2.3",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "supabase": "^2.19.7",
    "tailwindcss": "^4",
    "ts-jest": "^29.3.1",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
